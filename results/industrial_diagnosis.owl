  <rdf:type rdf:resource="#HydraulicFault"/>
  <affects_component rdf:resource="#hydraulic_circuit"/>
  <compatible_with_machine rdf:resource="#compressor"/>
  <compatible_with_machine rdf:resource="#industrial_pump"/>
  <rdfs:label xml:lang="it">Guasto idraulico</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#electric_motor">
  <rdf:type rdf:resource="#ElectricMotor"/>
  <has_component rdf:resource="#cooling_system"/>
  <has_component rdf:resource="#bearing"/>
  <has_component rdf:resource="#electrical_supply"/>
  <has_component rdf:resource="#motor_component"/>
  <has_sensor rdf:resource="#current_sensor"/>
  <has_sensor rdf:resource="#temperature_sensor"/>
  <has_sensor rdf:resource="#vibration_sensor"/>
  <rdfs:label xml:lang="it">Motore elettrico</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#industrial_pump">
  <rdf:type rdf:resource="#IndustrialPump"/>
  <has_component rdf:resource="#hydraulic_circuit"/>
  <has_component rdf:resource="#bearing"/>
  <has_component rdf:resource="#cooling_system"/>
  <has_component rdf:resource="#electrical_supply"/>
  <has_component rdf:resource="#motor_component"/>
  <has_sensor rdf:resource="#current_sensor"/>
  <has_sensor rdf:resource="#temperature_sensor"/>
  <has_sensor rdf:resource="#vibration_sensor"/>
  <has_sensor rdf:resource="#flow_sensor"/>
  <has_sensor rdf:resource="#pressure_sensor"/>
  <rdfs:label xml:lang="it">Pompa industriale</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#compressor">
  <rdf:type rdf:resource="#Compressor"/>
  <has_component rdf:resource="#hydraulic_circuit"/>
  <has_component rdf:resource="#bearing"/>
  <has_component rdf:resource="#cooling_system"/>
  <has_component rdf:resource="#electrical_supply"/>
  <has_component rdf:resource="#motor_component"/>
