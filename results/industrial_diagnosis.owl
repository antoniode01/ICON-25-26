</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#current_sensor">
  <rdf:type rdf:resource="#CurrentSensor"/>
  <monitors_component rdf:resource="#electrical_supply"/>
  <monitors_component rdf:resource="#motor_component"/>
