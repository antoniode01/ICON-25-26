<owl:NamedIndividual rdf:about="#vibration_sensor">
  <rdf:type rdf:resource="#VibrationSensor"/>
  <monitors_component rdf:resource="#bearing"/>
  <monitors_component rdf:resource="#motor_component"/>
  <monitors_component rdf:resource="#belt_drive"/>
  <rdfs:label xml:lang="it">Sensore di vibrazione</rdfs:label>
