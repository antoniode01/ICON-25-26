  <has_sensor rdf:resource="#temperature_sensor"/>
  <has_sensor rdf:resource="#vibration_sensor"/>
  <has_sensor rdf:resource="#flow_sensor"/>
  <has_sensor rdf:resource="#pressure_sensor"/>
