  <rdf:type rdf:resource="#ConveyorBelt"/>
  <has_component rdf:resource="#bearing"/>
  <has_component rdf:resource="#electrical_supply"/>
  <has_component rdf:resource="#motor_component"/>
  <has_component rdf:resource="#belt_drive"/>
  <has_sensor rdf:resource="#current_sensor"/>
  <has_sensor rdf:resource="#temperature_sensor"/>
  <has_sensor rdf:resource="#vibration_sensor"/>
  <rdfs:label xml:lang="it">Nastro trasportatore</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#motor_component">
  <rdf:type rdf:resource="#MotorComponent"/>
  <rdfs:label xml:lang="it">Componente motore</rdfs:label>
