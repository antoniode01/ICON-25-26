<owl:NamedIndividual rdf:about="#overheating">
  <rdf:type rdf:resource="#Symptom"/>
  <indicates_fault rdf:resource="#electrical_fault"/>
  <indicates_fault rdf:resource="#mechanical_fault"/>
  <indicates_fault rdf:resource="#thermal_fault"/>
  <rdf:type rdf:resource="#ElectricalSymptom"/>
  <rdf:type rdf:resource="#MechanicalSymptom"/>
  <rdf:type rdf:resource="#ThermalSymptom"/>
  <rdfs:label xml:lang="it">Surriscaldamento</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#abnormal_vibration">
  <rdf:type rdf:resource="#Symptom"/>
  <indicates_fault rdf:resource="#mechanical_fault"/>
  <indicates_fault rdf:resource="#hydraulic_fault"/>
  <indicates_fault rdf:resource="#thermal_fault"/>
  <rdf:type rdf:resource="#MechanicalSymptom"/>
  <rdf:type rdf:resource="#HydraulicSymptom"/>
  <rdf:type rdf:resource="#ThermalSymptom"/>
  <rdfs:label xml:lang="it">Vibrazione anomala</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#current_anomaly">
  <rdf:type rdf:resource="#Symptom"/>
  <indicates_fault rdf:resource="#electrical_fault"/>
  <indicates_fault rdf:resource="#mechanical_fault"/>
  <indicates_fault rdf:resource="#thermal_fault"/>
  <rdf:type rdf:resource="#ElectricalSymptom"/>
  <rdf:type rdf:resource="#MechanicalSymptom"/>
  <rdf:type rdf:resource="#ThermalSymptom"/>
  <rdfs:label xml:lang="it">Anomalia della corrente</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#pressure_anomaly">
  <rdf:type rdf:resource="#Symptom"/>
  <indicates_fault rdf:resource="#hydraulic_fault"/>
  <rdf:type rdf:resource="#HydraulicSymptom"/>
  <rdfs:label xml:lang="it">Anomalia della pressione</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#flow_anomaly">
  <rdf:type rdf:resource="#Symptom"/>
  <indicates_fault rdf:resource="#hydraulic_fault"/>
  <rdf:type rdf:resource="#HydraulicSymptom"/>
  <rdfs:label xml:lang="it">Anomalia della portata</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#unusual_noise">
  <rdf:type rdf:resource="#Symptom"/>
  <indicates_fault rdf:resource="#electrical_fault"/>
  <indicates_fault rdf:resource="#mechanical_fault"/>
  <indicates_fault rdf:resource="#hydraulic_fault"/>
  <rdf:type rdf:resource="#ElectricalSymptom"/>
  <rdf:type rdf:resource="#MechanicalSymptom"/>
  <rdf:type rdf:resource="#HydraulicSymptom"/>
  <rdfs:label xml:lang="it">Rumore anomalo</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#reduced_performance">
  <rdf:type rdf:resource="#Symptom"/>
  <indicates_fault rdf:resource="#electrical_fault"/>
  <indicates_fault rdf:resource="#mechanical_fault"/>
  <indicates_fault rdf:resource="#hydraulic_fault"/>
  <indicates_fault rdf:resource="#thermal_fault"/>
  <rdf:type rdf:resource="#ElectricalSymptom"/>
  <rdf:type rdf:resource="#MechanicalSymptom"/>
  <rdf:type rdf:resource="#HydraulicSymptom"/>
  <rdf:type rdf:resource="#ThermalSymptom"/>
  <rdfs:label xml:lang="it">Prestazioni ridotte</rdfs:label>
</owl:NamedIndividual>


</rdf:RDF>
