  <rdf:type rdf:resource="#BeltDrive"/>
  <rdfs:label xml:lang="it">Trasmissione a cinghia</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#temperature_sensor">
  <rdf:type rdf:resource="#TemperatureSensor"/>
  <monitors_component rdf:resource="#cooling_system"/>
  <monitors_component rdf:resource="#motor_component"/>
