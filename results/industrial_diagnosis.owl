<owl:NamedIndividual rdf:about="#bearing">
  <rdf:type rdf:resource="#Bearing"/>
  <rdfs:label xml:lang="it">Cuscinetto</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#cooling_system">
  <rdf:type rdf:resource="#CoolingSystem"/>
  <rdfs:label xml:lang="it">Sistema di raffreddamento</rdfs:label>
</owl:NamedIndividual>

